<Window x:Class="DotaAiCoach.UiOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DotaAiCoach.UiOverlay.ViewModels"
        mc:Ignorable="d"
        Title="Dota AI Coach"
        Width="300"
        Left="24" Top="24"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="720">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:OwnedOpacityConverter x:Key="OwnedOpacityConverter" />
    </Window.Resources>
    <!--
        Positioned top-left with a fixed offset, deliberately away from
        the minimap (bottom-left), inventory/ability bar (bottom-center),
        and top hero bar (top-center) per dota-overlay's HUD safe-zone
        guidance. Compact by default (dota-live-coach's 1-3 message cap) —
        this is the resting state; no expanded mode is implemented in this
        vertical slice.
    -->
    <Border Background="#CC101014" CornerRadius="8" Padding="14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <!--
                Drag handle: grabbing anywhere in this header row (except
                the minimize button itself) moves the window, per the
                user's explicit request. MouseLeftButtonDown on the Grid
                fires for clicks on the TextBlock/empty space; the Button
                consumes its own clicks first so it's unaffected.
            -->
            <Grid Margin="0,0,0,8" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DOTA AI COACH" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                <!--
                    Collapses the body below into a thin strip (just this
                    header row stays visible) rather than hiding the whole
                    window — the player can still see/drag/re-expand it
                    without going through the tray icon. Toggles between
                    "_" (collapse) and "▢" (expand) via IsCollapsed.
                -->
                <Button Grid.Column="1" Content="{Binding CollapseGlyph}" Click="OnMinimizeClick"
                        Width="22" Height="20" Padding="0" FontSize="12" FontWeight="Bold"
                        Foreground="#FFB0B0B0" Background="Transparent" BorderThickness="0"
                        ToolTip="{Binding CollapseTooltip}" />
            </Grid>

            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HeroName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <!--
                    Current Dota 2 patch (e.g. "7.38c"), fetched once from
                    OpenDota — see OverlayViewModel.GamePatchText. Shown
                    here instead of the live clock/KDA/gold/GPM-XPM/LH-DN/
                    buyback stats per explicit request to trim the overlay
                    down to identity + patch + the item plan only.
                -->
                <TextBlock Grid.Column="1" Text="{Binding GamePatchText}" Foreground="#FFDDDDDD" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center" />
            </Grid>

            <!--
                Always-visible item plan, grouped by phase (Early/Mid/
                Late/Situational) with a grid of item icons per phase —
                mirrors Dota's own in-game item guide layout, per the
                user's explicit request. Deliberately NOT part of the
                Messages feed above: per dota-live-coach, the live message
                stream stays short single-action fragments with
                cooldown-based anti-spam, but the user explicitly asked to
                always see the full build for the whole game, not just the
                currently-relevant phase. This panel has no cooldown/
                budget gating — it just reflects current state every
                recompute.
            -->
            <StackPanel>
                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,4,0,8" />
                <!--
                    MaxHeight + internal scroll: 4 phases x up to 6 items
                    each can exceed screen height on smaller monitors: this
                    keeps the window itself from growing past the screen
                    while still showing everything via scroll, rather than
                    silently clipping content off the bottom edge.
                -->
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ItemPlanGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding PhaseLabel}" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--
                                                    Icon + priority-percent label stacked, mirroring
                                                    Dota's own post-game item-guide win-rate-by-item
                                                    display (per explicit request/reference image) —
                                                    PriorityPercentText is empty (label collapsed) for
                                                    the rule/ML-driven plan, which has no percent.
                                                    IsOwned dims the cell and adds a checkmark badge
                                                    instead of removing the item from its phase, since
                                                    the player wants to see the whole planned build
                                                    including what's already bought.
                                                -->
                                                <StackPanel Margin="0,0,4,4" ToolTip="{Binding ItemDisplayName}">
                                                    <Grid Width="42" Height="30">
                                                        <Border Background="#22000000" CornerRadius="3" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                            <Image Source="{Binding IconImage}" Stretch="UniformToFill"
                                                                   Opacity="{Binding IsOwned, Converter={StaticResource OwnedOpacityConverter}}" />
                                                        </Border>
                                                        <Border Background="#CC1E7A3C" CornerRadius="0,3,0,3"
                                                                Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Visibility="{Binding IsOwned, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="&#10003;" Foreground="White" FontSize="9" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding PriorityPercentText}" Foreground="#FFE0B060" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                                               Visibility="{Binding HasPriorityPercent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <TextBlock Text="{Binding FeedStatusText}" Foreground="#FF777777" FontSize="10" Margin="0,8,0,0" />

            <!--
                Captures the pre-configured screen region, extracts the
                enemy scoreboard, and asks the LLM for a full item plan,
                all in one click, replacing ItemPlanGroups above directly
                (see OverlayViewModel.CaptureAndAskLlmAsync). No separate
                window anymore: this used to open a second "Ask LLM"
                window with its own capture buttons, which just added a
                click and a context switch for no benefit.
            -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Profile" Click="OnProfileClick" Padding="6,3" />
                <Button Content="Capturar pantalla" Click="OnCaptureScreenClick" Padding="6,3" Margin="8,0,0,0"
                        IsEnabled="{Binding HasCaptureRegion}" ToolTip="{Binding CaptureRegionText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Configurar region" Click="OnConfigureRegionClick" Padding="6,3" />
                <Button Content="Configurar tecla" Click="OnConfigureHotKeyClick" Padding="6,3" Margin="8,0,0,0" />
            </StackPanel>
            <!--
                The hotkey (default Ctrl+Tab, see HotKeySettings) runs
                the same CaptureAndAskLlmAsync pipeline as the button
                above, so the player can trigger a capture right after
                opening Dota's own scoreboard (Tab) without alt-tabbing
                to click anything.
            -->
            <TextBlock Text="{Binding HotKeyStatusText}" Foreground="#FF888888" FontSize="11" Margin="0,4,0,0" />
            <TextBlock Text="{Binding CaptureErrorText}" Foreground="#FFCC5555" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="Leyendo captura y pensando el build..." Foreground="#FFAACCAA" FontSize="11" Margin="0,4,0,0"
                       Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
