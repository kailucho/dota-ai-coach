<Window x:Class="DotaAiCoach.UiOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dota AI Coach"
        Width="300"
        Left="24" Top="24"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="620">
    <!--
        Positioned top-left with a fixed offset, deliberately away from
        the minimap (bottom-left), inventory/ability bar (bottom-center),
        and top hero bar (top-center) per dota-overlay's HUD safe-zone
        guidance. Compact by default (dota-live-coach's 1-3 message cap) —
        this is the resting state; no expanded mode is implemented in this
        vertical slice.
    -->
    <Border Background="#CC101014" CornerRadius="8" Padding="14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DOTA AI COACH" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                <!--
                    Hides to the system tray (see App.xaml.cs's NotifyIcon)
                    rather than a normal Windows minimize, since this
                    window has no taskbar presence by design (dota-overlay)
                    — a real WindowState.Minimized would have no way back.
                -->
                <Button Grid.Column="1" Content="_" Click="OnMinimizeClick"
                        Width="22" Height="20" Padding="0" FontSize="12" FontWeight="Bold"
                        Foreground="#FFB0B0B0" Background="Transparent" BorderThickness="0"
                        ToolTip="Minimize to tray" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HeroName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ClockText}" Foreground="#FFDDDDDD" FontSize="16" FontFamily="Consolas" />
            </Grid>

            <TextBlock Text="{Binding KdaText}" Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0" />
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="Gold: " /><Run Text="{Binding GoldText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="GPM/XPM: " /><Run Text="{Binding GpmXpmText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="LH/DN: " /><Run Text="{Binding LastHitDenyText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,8">
                <Run Text="Buyback: " /><Run Text="{Binding BuybackText, Mode=OneWay}" />
            </TextBlock>

            <!--
                Always-visible item plan, grouped by phase (Early/Mid/
                Late/Situational) with a grid of item icons per phase —
                mirrors Dota's own in-game item guide layout, per the
                user's explicit request. Deliberately NOT part of the
                Messages feed above: per dota-live-coach, the live message
                stream stays short single-action fragments with
                cooldown-based anti-spam, but the user explicitly asked to
                always see the full build for the whole game, not just the
                currently-relevant phase. This panel has no cooldown/
                budget gating — it just reflects current state every
                recompute.
            -->
            <StackPanel>
                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,4,0,8" />
                <!--
                    MaxHeight + internal scroll: 4 phases x up to 6 items
                    each can exceed screen height on smaller monitors: this
                    keeps the window itself from growing past the screen
                    while still showing everything via scroll, rather than
                    silently clipping content off the bottom edge.
                -->
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ItemPlanGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding PhaseLabel}" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="42" Height="30" Background="#22000000" CornerRadius="3"
                                                        Margin="0,0,4,4" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                        ToolTip="{Binding ItemDisplayName}">
                                                    <Image Source="{Binding IconImage}" Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <TextBlock Text="{Binding FeedStatusText}" Foreground="#FF777777" FontSize="10" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Profile" Click="OnProfileClick" Padding="6,3" />
                <Button Content="Ask LLM" Click="OnAskLlmClick" Padding="6,3" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
