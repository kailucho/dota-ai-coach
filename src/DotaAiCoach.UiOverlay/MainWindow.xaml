<Window x:Class="DotaAiCoach.UiOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dota AI Coach"
        Width="260" Height="360"
        Left="24" Top="24"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <!--
        Positioned top-left with a fixed offset, deliberately away from
        the minimap (bottom-left), inventory/ability bar (bottom-center),
        and top hero bar (top-center) per dota-overlay's HUD safe-zone
        guidance. Compact by default (dota-live-coach's 1-3 message cap) —
        this is the resting state; no expanded mode is implemented in this
        vertical slice.
    -->
    <Border Background="#CC101014" CornerRadius="8" Padding="14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="DOTA AI COACH" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HeroName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ClockText}" Foreground="#FFDDDDDD" FontSize="16" FontFamily="Consolas" />
            </Grid>

            <TextBlock Text="{Binding KdaText}" Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0" />
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="Gold: " /><Run Text="{Binding GoldText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="GPM/XPM: " /><Run Text="{Binding GpmXpmText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,0">
                <Run Text="LH/DN: " /><Run Text="{Binding LastHitDenyText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="13" Margin="0,2,0,8">
                <Run Text="Buyback: " /><Run Text="{Binding BuybackText, Mode=OneWay}" />
            </TextBlock>

            <ItemsControl ItemsSource="{Binding ItemNames}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FF9DBFD1" FontSize="11" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="4" Background="#22FFFFFF">
                            <TextBlock Text="{Binding Text}" Foreground="#FFFFE9B0" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding FeedStatusText}" Foreground="#FF777777" FontSize="10" Margin="0,8,0,0" />

            <Button Content="Profile" Click="OnProfileClick" Margin="0,8,0,0" Padding="6,3" HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
</Window>
