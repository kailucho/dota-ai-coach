<Window x:Class="DotaAiCoach.UiOverlay.AskLlmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ask for a build (LLM)"
        Width="460" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#FF1A1A1E"
        ResizeMode="CanResize"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#FFCC5555" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding AvailabilityText}" />

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Minuto:" Foreground="White" Width="120" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MinuteOfMatch, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mi heroe:" Foreground="White" Width="120" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OwnHero, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mi KDA:" Foreground="White" Width="120" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OwnKda, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Enemigos esperados (opcional, separados por coma):"
                       Foreground="White" Width="120" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding EnemyHeroesHint, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
        </Grid>

        <!--
            Drag-and-drop scoreboard screenshot upload, mirroring
            dota-plus-free's TickForm.tsx: drop or click to pick an image,
            auto-extract on selection via OpenAiScoreboardExtractor. The
            image itself never leaves the machine except to OpenAI's API
            for this one recognition call.
        -->
        <Border Grid.Row="5" BorderBrush="#4433FFFF" BorderThickness="2" CornerRadius="8"
                Background="#0AFFFFFF" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Captura del scoreboard enemigo" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,6" />
                <Button Content="Elegir imagen (o arrastra aqui)" Click="OnPickImageClick" Padding="10,4" HorizontalAlignment="Left" />
                <Image Source="{Binding ScreenshotPreview}" MaxHeight="140" Margin="0,8,0,0" Stretch="Uniform" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding ExtractionSummary}" Foreground="#FFAACCAA" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" />

        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ExtraNotes, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,8,0" ToolTip="Notas adicionales (opcional)" />
            <Button Grid.Column="1" Content="Preguntar" Padding="12,4" Click="OnAskClick"
                    IsEnabled="{Binding IsAvailable}" />
        </Grid>

        <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ErrorText}" Foreground="#FFCC5555" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="{Binding StatusText}" Foreground="#FFAAAAAA" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ResponseText}" Foreground="White" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
