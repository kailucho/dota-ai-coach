<Window x:Class="DotaAiCoach.UiOverlay.HotKeyPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar tecla de captura"
        Width="360" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="#FF1A1A1E"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Presiona la combinacion de teclas que quieres usar"
                   Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="{Binding CapturedText}" Foreground="White" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock Text="{Binding ErrorText}" Foreground="#FFCC5555" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="{Binding WarningText}" Foreground="#FFDDAA55" TextWrapping="Wrap" />
        <TextBlock Text="Esc para cancelar" Foreground="#FF777777" FontSize="11" Margin="0,8,0,0" />
    </StackPanel>
</Window>
