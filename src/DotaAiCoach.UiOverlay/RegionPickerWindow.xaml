<Window x:Class="DotaAiCoach.UiOverlay.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#40000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        KeyDown="OnKeyDown">
    <Grid>
        <TextBlock Text="Arrastra un rectangulo sobre la zona del KDA/scoreboard. Esc para cancelar."
                   Foreground="White" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle" Stroke="#FF00CC66" StrokeThickness="2" Fill="#3300CC66" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
