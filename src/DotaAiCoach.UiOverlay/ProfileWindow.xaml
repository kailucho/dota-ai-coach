<Window x:Class="DotaAiCoach.UiOverlay.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Player Profile"
        Width="420" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF1A1A1E"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SteamIdInput, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="6" Margin="0,0,8,0"
                     ToolTip="Paste your Steam64 ID (from GSI/Steam profile URL) or your OpenDota account_id (Steam32)." />
            <Button Grid.Column="1" Content="Refresh" Padding="10,4" Click="OnRefreshClick" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding AvailabilityText}" Foreground="#FFDDA85A" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold">
                <Run Text="{Binding PersonaNameText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="#FFCCCCCC" FontSize="12">
                <Run Text="Rank tier: " /><Run Text="{Binding RankText, Mode=OneWay}" />
                <Run Text="  Record: " /><Run Text="{Binding RecordText, Mode=OneWay}" />
            </TextBlock>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Deep DNA Refresh" Padding="8,3" Click="OnDeepDnaRefreshClick"
                        ToolTip="Parses up to 20 of your most recent ranked matches on OpenDota to unlock Laning, Objectives, Vision, Itemization, Buyback Discipline and Tempo. Slower and uses more of OpenDota's rate limit than a normal Refresh — use sparingly." />
                <TextBlock Grid.Column="1" Text="{Binding DeepRefreshStatusText, Mode=OneWay}" Foreground="#FF888888" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="HERO COMFORT" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding HeroComfortScores}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#FFCCCCCC" FontSize="12">
                                    <Run Text="Hero " /><Run Text="{Binding HeroId, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding ScoreText, Mode=OneWay}" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Foreground="#FF888888" FontSize="11">
                                    <Run Text="(" /><Run Text="{Binding GamesText, Mode=OneWay}" /><Run Text=" games)" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="DOTA DNA" Foreground="#FFB0B0B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding DnaDimensions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DimensionName, Mode=OneWay}" Foreground="#FFCCCCCC" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding ScoreText, Mode=OneWay}" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding AvailabilityNote, Mode=OneWay}" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
